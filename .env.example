# Flask Configuration
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
PORT=5000

# SQLite Database Location
DATABASE_PATH=data/jobs.db

# Hosted AI Model API Configuration (OpenAI-compatible)
# Supported options: Groq, Together, OpenRouter, Gemini (OpenAI layer), Ollama, etc.
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL_NAME=llama-3.3-70b-versatile

# Tertiary (Third) AI Provider Configuration
THIRD_AI_API_KEY=your_third_ai_api_key_here
THIRD_AI_BASE_URL=https://openrouter.ai/api/v1
THIRD_AI_MODEL_NAME=meta-llama/llama-3.3-70b-instruct

ADZUNA_APP_ID=ID HERE
ADZUNA_APP_KEY=YOUR_NEW_KEY_HERE
ADZUNA_COUNTRY=in

# LaTeX pdflatex Executable Path (if not on system PATH)
PDFLATEX_PATH=pdflatex

# Google API Configuration
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

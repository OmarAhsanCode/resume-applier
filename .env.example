# ==============================================================================
# Environment Configuration
# ==============================================================================

# Application Environment (development | testing | production)
APP_ENV=development
FLASK_ENV=development

# Flask Secret Key (REQUIRED in production - generate with: openssl rand -hex 32)
SECRET_KEY=dev-secret-key-change-in-production

# Server Host and Port
HOST=0.0.0.0
PORT=5000

# SQLite Database Location
DATABASE_PATH=data/jobs.db

# Storage Directories
UPLOAD_FOLDER=uploads
GENERATED_RESUMES_DIR=generated/resumes
CONFIG_DIR=config

# Security & Request Limits
MAX_CONTENT_LENGTH=16777216
SESSION_COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ==============================================================================
# AI Provider Configuration (Hosted OpenAI-compatible APIs)
# ==============================================================================

# Primary AI Provider (e.g., Groq, Together, DeepInfra)
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL_NAME=llama-3.3-70b-versatile

# Secondary Fallback AI Provider
SECOND_AI_API_KEY=your_second_ai_api_key_here
SECOND_AI_BASE_URL=https://api.groq.com/openai/v1
SECOND_AI_MODEL_NAME=llama-3.3-70b-versatile

# Tertiary Fallback AI Provider (e.g., OpenRouter)
THIRD_AI_API_KEY=your_third_ai_api_key_here
THIRD_AI_BASE_URL=https://openrouter.ai/api/v1
THIRD_AI_MODEL_NAME=meta-llama/llama-3.3-70b-instruct

# Resume Optimizer Iteration Limits
RESUME_MAX_ITERATIONS=5
BACKGROUND_RESUME_MAX_ITERATIONS=2
AI_REQUEST_TIMEOUT=30

# ==============================================================================
# LaTeX / PDF Compilation
# ==============================================================================

# Executable Path (if not on PATH, e.g. /usr/bin/pdflatex or C:\miktex\pdflatex.exe)
PDFLATEX_PATH=pdflatex
PDFLATEX_TIMEOUT=30

# ==============================================================================
# External Career & ATS Integrations (Optional)
# ==============================================================================

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Browser Discovery (Playwright)
BROWSER_DISCOVERY_TIMEOUT=15000
BROWSER_DISCOVERY_MAX_PAGES=5

# ==============================================================================
# Google Sheets & Drive Integration (Optional)
# ==============================================================================

GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
